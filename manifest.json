{
  "manifest_version": 3,
  "name": "erasr",
  "version": "1.1.0",
  "description": "Review and delete browsing history by site or keyword.",
  "permissions": ["history"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "erasr",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
